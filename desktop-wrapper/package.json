{
  "name": "monqey-code-desktop",
  "version": "0.0.17",
  "private": true,
  "description": "Minimal Electron wrapper for the existing DSH web profile",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test:paths": "node --test paths.test.cjs launcher.test.cjs",
    "test:chrome": "node --test desktop-chrome.test.cjs icons.test.cjs shortcuts.test.cjs ../packages/monqey-code-brand/environment.test.cjs",
    "test:mobile": "node --test mobile-account.test.cjs mobile-access.test.cjs mobile-desktop.test.cjs ../packages/monqey-code-brand/mobile-access.test.cjs",
    "relay:mobile": "node mobile-relay.cjs",
    "prepare:qoder-runtime": "node prepare-qoder-runtime.cjs",
    "prepare:browser": "node ../packages/monqey-code-workspace-tools/setup-browser.cjs",
    "test:workspace-tools": "node --test browser-links.test.cjs ../packages/monqey-code-workspace-tools/test/*.test.mjs",
    "prepare:speech": "node setup-speech.cjs",
    "test:speech": "node --test dictation.test.cjs ../packages/monqey-code-brand/dictation.test.cjs",
    "prebuild": "npm run prepare:qoder-runtime && npm run prepare:browser",
    "build": "electron-builder --win portable",
    "postbuild": "electron shortcuts-setup.cjs"
  },
  "devDependencies": {
    "electron": "latest",
    "electron-builder": "latest"
  },
  "build": {
    "appId": "com.monqey.code",
    "productName": "Monqey Agent",
    "directories": {
      "output": "dist-cowork"
    },
    "asar": true,
    "icon": "assets/monqey.ico",
    "files": [
      "main.js",
      "paths.cjs",
      "attention.cjs",
      "desktop-chrome.cjs",
      "browser-links.cjs",
      "dictation.cjs",
      "DICTATION-LICENSE.txt",
      "shortcuts.cjs",
      "mobile-access.cjs",
      "mobile-account.cjs",
      "mobile-account-config.json",
      "mobile-desktop.cjs",
      "mobile-protocol.cjs",
      "mobile-runtime.cjs",
      "preload.js",
      "package.json",
      "assets/monqey.ico"
    ],
    "extraResources": [
      { "from": "dictation-worker.py", "to": "dictation-worker.py" },
      {
        "from": "../profiles/web/node_modules/@qoder-ai/qoder-agent-sdk/dist/_worker",
        "to": "qoder-agent-sdk/_worker"
      },
      {
        "from": "../profiles/web/node_modules/@qoder-ai/qoder-agent-sdk/dist/_bundled",
        "to": "qoder-agent-sdk/_bundled"
      }
    ],
    "win": {
      "signExecutable": false,
      "target": "portable"
    }
  },
  "dependencies": {
    "qrcode": "1.5.4",
    "ws": "8.22.0"
  }
}
